---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="logo" href="/">{SITE_TITLE}</a>
		<div class="nav-right">
			<a href="/blog/">Artículos</a>
			<a href="/about/">Sobre nosotros</a>
			<div class="search-wrapper">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				<input type="search" placeholder="Buscar artículos..." aria-label="Buscar artículos" />
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		padding: 1.25em 2.5em;
		background: white;
		border-bottom: 1px solid rgba(var(--gray-light), 0.7);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
	}
	.logo {
		font-size: 1.5em;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-decoration: none;
		color: rgb(var(--black));
		flex-shrink: 0;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5em;
		flex-shrink: 0;
	}
	.nav-right > a {
		text-decoration: none;
		color: rgb(var(--gray-dark));
		font-size: 0.9em;
		transition: color 0.2s ease;
		white-space: nowrap;
	}
	.nav-right > a:hover {
		color: rgb(var(--black));
	}
	.search-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}
	.search-wrapper svg {
		position: absolute;
		left: 0.75em;
		color: rgb(var(--gray));
		pointer-events: none;
	}
	.search-wrapper input {
		padding: 0.55em 1em 0.55em 2.3em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 100px;
		font-size: 0.85em;
		width: 200px;
		background: rgba(var(--gray-light), 0.3);
		transition: all 0.2s ease;
		outline: none;
	}
	.search-wrapper input:focus {
		border-color: rgb(var(--gray));
		background: white;
		width: 260px;
	}
	@media (max-width: 768px) {
		header {
			padding: 1em 1.25em;
		}
		.logo {
			font-size: 1.2em;
		}
		.nav-right {
			gap: 1em;
		}
		.nav-right > a {
			font-size: 0.8em;
		}
		.search-wrapper input {
			width: 120px;
			font-size: 0.8em;
			padding: 0.5em 0.8em 0.5em 2em;
		}
		.search-wrapper input:focus {
			width: 140px;
		}
		.search-wrapper svg {
			width: 14px;
			height: 14px;
			left: 0.6em;
		}
	}
</style>
