---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	currentId: string;
	category?: string;
}

const { currentId, category } = Astro.props;

const allPosts = (await getCollection('blog'))
	.filter((p) => p.id !== currentId)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const sameCategory = category
	? allPosts.filter((p) => p.data.category === category)
	: [];
const others = allPosts.filter((p) => !sameCategory.includes(p));
const related = [...sameCategory, ...others].slice(0, 3);
---

{related.length > 0 && (
	<section class="related-section">
		<div class="related-inner">
			<h2 class="related-title">Sigue leyendo</h2>
			<div class="related-grid">
				{related.map((post) => (
					<a href={`/blog/${post.id}/`} class="related-card">
						{post.data.heroImage && (
							<Image width={400} height={300} src={post.data.heroImage} alt="" />
						)}
						<div class="related-info">
							{post.data.category && <span class="related-category">{post.data.category}</span>}
							<span class="related-date"><FormattedDate date={post.data.pubDate} /></span>
							<h3>{post.data.title}</h3>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.related-section {
		border-top: 1px solid rgb(var(--gray-light));
		padding: 4em 2em;
		margin-top: 4em;
	}
	.related-inner {
		max-width: 1200px;
		margin: 0 auto;
	}
	.related-title {
		font-family: var(--font-body);
		font-size: 1.1em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1.5em;
		color: rgb(var(--black));
		font-weight: 800;
		text-align: center;
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5em;
	}
	.related-card {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease;
		min-width: 0;
	}
	.related-card:hover {
		transform: translateY(-4px);
	}
	.related-card :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 10px;
		margin-bottom: 1em;
	}
	.related-category {
		font-family: var(--font-body);
		font-size: 0.75em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-warm);
		display: block;
		margin-bottom: 0.3em;
	}
	.related-date {
		font-family: var(--font-body);
		font-size: 1em;
		color: var(--color-ink-blue);
		display: block;
		margin-bottom: 0.4em;
	}
	.related-info h3 {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.1em;
		margin: 0;
		line-height: 1.35;
		letter-spacing: -0.005em;
		color: rgb(var(--black));
	}
	@media (max-width: 1024px) {
		.related-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 768px) {
		.related-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
		.related-section {
			padding: 3em 1.25em;
		}
	}
</style>
