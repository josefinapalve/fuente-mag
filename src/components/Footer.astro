---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="social-links">
			<a href="https://www.instagram.com/fuentemag/" target="_blank" rel="noopener" aria-label="Instagram">
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
			</a>
		</div>
		<a href="/about/" class="about-link">Propósito</a>
		<p class="copyright">&copy; {today.getFullYear()} FUENTE. Todos los derechos reservados.</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 2em;
		text-align: center;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.footer-content {
		max-width: 960px;
		margin: 0 auto;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-bottom: 1.5em;
	}
	.social-links a {
		color: rgb(var(--gray));
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: rgb(var(--black));
	}
	.about-link {
		display: inline-block;
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.85em;
		margin-bottom: 1em;
		transition: color 0.2s ease;
	}
	.about-link:hover {
		color: rgb(var(--black));
	}
	.copyright {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin: 0;
	}
</style>
