---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import VersiculoDelDia from '../components/VersiculoDelDia.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featuredPost, ...restPosts] = posts;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Hero: artículo destacado -->
		{featuredPost && (
			<section class="hero">
				<a href={`/blog/${featuredPost.id}/`} class="hero-link">
					<div class="hero-image-wrapper">
						{featuredPost.data.heroImage && (
							<Image
								width={1400}
								height={600}
								src={featuredPost.data.heroImage}
								alt=""
								class="hero-image"
							/>
						)}
						<div class="hero-overlay">
							<span class="hero-label">{featuredPost.data.category || 'Último artículo'}</span>
							<h1>{featuredPost.data.title}</h1>
							<p class="hero-description">{featuredPost.data.description}</p>
						</div>
					</div>
				</a>
			</section>
		)}

		<div class="reveal-soft"><VersiculoDelDia /></div>

		<main>
			<!-- Todos los artículos en grilla -->
			<section class="articles-section">
				<h2 class="section-title reveal">Artículos</h2>
				<div class="articles-grid reveal-stagger">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="article-card">
							{post.data.heroImage && (
								<Image width={400} height={300} src={post.data.heroImage} alt="" />
							)}
							<div class="article-info">
								{post.data.category && <span class="article-category">{post.data.category}</span>}
								<span class="article-date"><FormattedDate date={post.data.pubDate} /></span>
								<h3>{post.data.title}</h3>
								<p class="article-description">{post.data.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- Playlist del mes -->
			<section class="playlist-section reveal">
				<h2 class="section-title">Playlist del mes</h2>
				<div class="playlist-card">
					<div class="playlist-text">
						<h3>Julio 2026</h3>
						<p>Nuestra selección mensual de música que nos está moviendo. Canciones para descubrir, redescubrir y cantarle a Dios.</p>
						<a href="https://open.spotify.com" target="_blank" rel="noopener" class="playlist-link">
							Escuchar en Spotify →
						</a>
					</div>
					<div class="playlist-visual">
						<div class="playlist-placeholder">
							<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 11.973c2.5-1.473 5.5-.973 7.5.527"/><path d="M9 15c1.5-1 4-.5 5 .5"/><path d="M7 9c2-1.5 6-2 9 .5"/></svg>
							<span>Playlist embed</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Newsletter -->
			<section class="newsletter-section reveal">
				<div class="newsletter-inner">
					<h2>No te pierdas nada</h2>
					<p>Recibe nuestros artículos, playlists y recomendaciones directamente en tu correo.</p>
					<form class="newsletter-form" onsubmit="event.preventDefault()">
						<input type="email" placeholder="Tu email" aria-label="Tu email" required />
						<button type="submit">Suscribirme</button>
					</form>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero — full width */
	.hero {
		width: 100%;
	}
	.hero-link {
		text-decoration: none;
		color: white;
		display: block;
	}
	.hero-image-wrapper {
		position: relative;
		width: 100%;
		overflow: hidden;
	}
	.hero-image {
		width: 100%;
		height: 75vh;
		min-height: 400px;
		max-height: 650px;
		object-fit: cover;
		display: block;
		border-radius: 0;
		filter: brightness(0.65);
		transition: filter 0.4s ease, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
		animation: hero-zoom-in 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}
	.hero-link:hover .hero-image {
		filter: brightness(0.55);
		transform: scale(1.02);
	}
	@keyframes hero-zoom-in {
		from {
			transform: scale(1.08);
			filter: brightness(0.5);
		}
		to {
			transform: scale(1);
			filter: brightness(0.65);
		}
	}
	.hero-overlay {
		animation: hero-overlay-in 0.9s 0.3s ease-out both;
	}
	@keyframes hero-overlay-in {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.hero-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 4em 5%;
		background: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.25) 60%, rgba(0,0,0,0.15) 100%);
	}
	.hero-label {
		font-family: var(--font-body);
		font-size: 1.05em;
		opacity: 0.9;
		display: inline-block;
		margin-bottom: 0.2em;
	}
	.hero h1 {
		color: white;
		font-size: clamp(1.8em, 4vw, 3em);
		margin: 0.3em 0 0.4em;
		line-height: 1.1;
		max-width: 700px;
	}
	.hero-description {
		font-size: clamp(0.9em, 1.5vw, 1.1em);
		opacity: 0.9;
		margin: 0;
		max-width: 550px;
		line-height: 1.5;
	}

	/* Section titles */
	.section-title {
		font-family: var(--font-body);
		font-size: 1.1em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1.5em;
		color: rgb(var(--black));
		font-weight: 800;
	}

	/* Articles grid */
	.articles-section {
		margin-bottom: 5em;
		padding-top: 1em;
	}
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5em;
	}
	.article-card {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.article-card :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 10px;
		margin-bottom: 1em;
		transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.3s ease;
	}
	.article-card:hover :global(img) {
		transform: scale(1.03);
		filter: brightness(0.92) saturate(1.1);
	}
	.article-info h3 {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.15em;
		margin: 0 0 0.4em;
		line-height: 1.35;
		letter-spacing: -0.005em;
		color: rgb(var(--black));
		transition: color 0.2s ease;
	}
	.article-card:hover h3 {
		color: var(--color-ink-blue);
	}
	.article-description {
		font-size: 0.85em;
		color: rgb(var(--black));
		margin: 0 0 0.6em;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.article-category {
		font-family: var(--font-body);
		font-size: 0.75em;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-warm);
		display: block;
		margin-bottom: 0.3em;
	}
	.article-date {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 1.05em;
		color: var(--color-ink-blue);
		line-height: 1.4;
		display: block;
		margin-bottom: 0.4em;
		overflow: visible;
	}
	.article-date :global(time) {
		display: inline-block;
		line-height: inherit;
	}

	/* Playlist — bloque cálido */
	.playlist-section {
		margin-bottom: 5em;
	}
	.playlist-card {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 3em;
		align-items: center;
		background: #f4f4f4;
		padding: 3.5em;
		color: rgb(var(--black));
		border-radius: 24px;
	}
	.playlist-text h3 {
		font-family: var(--font-display);
		font-size: clamp(2em, 4vw, 3em);
		margin: 0 0 0.4em;
		font-weight: 500;
		color: rgb(var(--black));
		line-height: 1;
	}
	.playlist-text p {
		color: rgb(var(--gray-dark));
		font-size: 1em;
		margin: 0 0 1.8em;
		line-height: 1.6;
	}
	.playlist-link {
		display: inline-block;
		color: white;
		background: var(--color-ink-blue);
		padding: 0.8em 1.6em;
		border-radius: 100px;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9em;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.playlist-link:hover {
		background: rgb(var(--black));
		transform: translateY(-2px);
	}
	.playlist-visual {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.playlist-placeholder {
		width: 100%;
		aspect-ratio: 1;
		max-width: 320px;
		background: rgba(0, 0, 0, 0.1);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.8em;
		color: rgba(0, 0, 0, 0.6);
		font-size: 0.85em;
	}

	/* Newsletter — bloque oscuro */
	.newsletter-section {
		background: rgb(var(--black));
		margin: 5em -2.5em -3em;
		padding: 5em 2.5em;
		color: white;
	}
	.newsletter-inner {
		max-width: 560px;
		margin: 0 auto;
		text-align: center;
	}
	.newsletter-inner h2 {
		font-size: clamp(1.8em, 3.5vw, 2.6em);
		margin: 0 0 0.4em;
		color: white;
	}
	.newsletter-inner p {
		color: rgba(255, 255, 255, 0.7);
		font-size: 1em;
		margin: 0 0 2em;
	}
	.newsletter-form {
		display: flex;
		gap: 0.6em;
	}
	.newsletter-form input {
		flex: 1;
		padding: 0.95em 1.3em;
		border: 1px solid rgba(255, 255, 255, 0.25);
		background: transparent;
		color: white;
		border-radius: 100px;
		font-size: 0.95em;
		outline: none;
		transition: border-color 0.2s ease;
	}
	.newsletter-form input::placeholder {
		color: rgba(255, 255, 255, 0.45);
	}
	.newsletter-form input:focus {
		border-color: var(--color-butter);
	}
	.newsletter-form button {
		padding: 0.95em 2em;
		background: var(--color-butter);
		color: rgb(var(--black));
		border: none;
		border-radius: 100px;
		font-size: 0.95em;
		font-weight: 700;
		cursor: pointer;
		transition: transform 0.2s ease, background 0.2s ease;
		white-space: nowrap;
	}
	.newsletter-form button:hover {
		background: white;
		transform: translateY(-2px);
	}

	@media (max-width: 1024px) {
		.articles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 768px) {
		.hero-image {
			height: 50vh;
			min-height: 300px;
		}
		.hero-overlay {
			padding: 2em 1.25em;
		}
		.articles-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
		.playlist-card {
			grid-template-columns: 1fr;
			padding: 2em;
		}
		.playlist-placeholder {
			max-width: 200px;
		}
		.newsletter-form {
			flex-direction: column;
		}
	}
</style>
