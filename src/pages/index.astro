---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featuredPost, ...restPosts] = posts;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<!-- Hero: artículo destacado -->
		{featuredPost && (
			<section class="hero">
				<a href={`/blog/${featuredPost.id}/`} class="hero-link">
					<div class="hero-image-wrapper">
						{featuredPost.data.heroImage && (
							<Image
								width={1400}
								height={600}
								src={featuredPost.data.heroImage}
								alt=""
								class="hero-image"
							/>
						)}
						<div class="hero-overlay">
							<span class="hero-label">Último artículo</span>
							<h1>{featuredPost.data.title}</h1>
							<p class="hero-description">{featuredPost.data.description}</p>
						</div>
					</div>
				</a>
			</section>
		)}

		<main>
			<!-- Todos los artículos en grilla -->
			<section class="articles-section">
				<h2 class="section-title">Artículos</h2>
				<div class="articles-grid">
					{posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="article-card">
							{post.data.heroImage && (
								<Image width={400} height={300} src={post.data.heroImage} alt="" />
							)}
							<div class="article-info">
								<h3>{post.data.title}</h3>
								<p class="article-description">{post.data.description}</p>
								<span class="article-date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- Playlist del mes -->
			<section class="playlist-section">
				<h2 class="section-title">Playlist del mes</h2>
				<div class="playlist-card">
					<div class="playlist-text">
						<h3>Julio 2026</h3>
						<p>Nuestra selección mensual de música que nos está moviendo. Canciones para descubrir, redescubrir y cantarle a Dios.</p>
						<a href="https://open.spotify.com" target="_blank" rel="noopener" class="playlist-link">
							Escuchar en Spotify →
						</a>
					</div>
					<div class="playlist-visual">
						<div class="playlist-placeholder">
							<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 11.973c2.5-1.473 5.5-.973 7.5.527"/><path d="M9 15c1.5-1 4-.5 5 .5"/><path d="M7 9c2-1.5 6-2 9 .5"/></svg>
							<span>Playlist embed</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Newsletter -->
			<section class="newsletter-section">
				<div class="newsletter-inner">
					<h2>No te pierdas nada</h2>
					<p>Recibí nuestros artículos, playlists y recomendaciones directamente en tu mail.</p>
					<form class="newsletter-form" onsubmit="event.preventDefault()">
						<input type="email" placeholder="Tu email" aria-label="Tu email" required />
						<button type="submit">Suscribirme</button>
					</form>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero — full width */
	.hero {
		width: 100%;
	}
	.hero-link {
		text-decoration: none;
		color: white;
		display: block;
	}
	.hero-image-wrapper {
		position: relative;
		width: 100%;
		overflow: hidden;
	}
	.hero-image {
		width: 100%;
		height: 75vh;
		min-height: 400px;
		max-height: 650px;
		object-fit: cover;
		display: block;
		border-radius: 0;
		filter: brightness(0.65);
		transition: filter 0.3s ease;
	}
	.hero-link:hover .hero-image {
		filter: brightness(0.55);
	}
	.hero-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 4em 5%;
		background: linear-gradient(transparent, rgba(0,0,0,0.5));
	}
	.hero-label {
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		opacity: 0.8;
	}
	.hero h1 {
		color: white;
		font-size: clamp(1.8em, 4vw, 3em);
		margin: 0.3em 0 0.4em;
		line-height: 1.1;
		max-width: 700px;
	}
	.hero-description {
		font-size: clamp(0.9em, 1.5vw, 1.1em);
		opacity: 0.9;
		margin: 0;
		max-width: 550px;
		line-height: 1.5;
	}

	/* Section titles */
	.section-title {
		font-size: 1.1em;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1.5em;
		color: rgb(var(--gray));
		font-weight: 700;
	}

	/* Articles grid */
	.articles-section {
		margin-bottom: 5em;
		padding-top: 1em;
	}
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5em;
	}
	.article-card {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease;
		min-width: 0;
	}
	.article-card:hover {
		transform: translateY(-4px);
	}
	.article-card :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 10px;
		margin-bottom: 1em;
	}
	.article-info h3 {
		font-size: 1.15em;
		margin: 0 0 0.4em;
		line-height: 1.3;
		color: rgb(var(--black));
	}
	.article-card:hover h3 {
		color: var(--accent);
	}
	.article-description {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 0 0 0.6em;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.article-date {
		font-size: 0.78em;
		color: rgb(var(--gray));
	}

	/* Playlist */
	.playlist-section {
		margin-bottom: 5em;
	}
	.playlist-card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3em;
		align-items: center;
		background: rgba(var(--gray-light), 0.35);
		border-radius: 16px;
		padding: 3em;
	}
	.playlist-text h3 {
		font-size: 1.5em;
		margin: 0 0 0.6em;
	}
	.playlist-text p {
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
		margin: 0 0 1.5em;
		line-height: 1.6;
	}
	.playlist-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95em;
	}
	.playlist-link:hover {
		text-decoration: underline;
	}
	.playlist-visual {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.playlist-placeholder {
		width: 100%;
		aspect-ratio: 1;
		max-width: 300px;
		background: rgba(var(--gray-light), 0.6);
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.8em;
		color: rgb(var(--gray));
		font-size: 0.85em;
	}

	/* Newsletter */
	.newsletter-section {
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 4em;
		margin-bottom: 2em;
	}
	.newsletter-inner {
		max-width: 500px;
		margin: 0 auto;
		text-align: center;
	}
	.newsletter-inner h2 {
		font-size: 1.8em;
		margin: 0 0 0.4em;
	}
	.newsletter-inner p {
		color: rgb(var(--gray));
		font-size: 0.95em;
		margin: 0 0 2em;
	}
	.newsletter-form {
		display: flex;
		gap: 0.6em;
	}
	.newsletter-form input {
		flex: 1;
		padding: 0.85em 1.2em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 100px;
		font-size: 0.9em;
		outline: none;
		transition: border-color 0.2s ease;
	}
	.newsletter-form input:focus {
		border-color: rgb(var(--gray));
	}
	.newsletter-form button {
		padding: 0.85em 2em;
		background: rgb(var(--black));
		color: white;
		border: none;
		border-radius: 100px;
		font-size: 0.9em;
		font-weight: 700;
		cursor: pointer;
		transition: opacity 0.2s ease;
		white-space: nowrap;
	}
	.newsletter-form button:hover {
		opacity: 0.8;
	}

	@media (max-width: 1024px) {
		.articles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 768px) {
		.hero-image {
			height: 50vh;
			min-height: 300px;
		}
		.hero-overlay {
			padding: 2em 1.25em;
		}
		.articles-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
		.playlist-card {
			grid-template-columns: 1fr;
			padding: 2em;
		}
		.playlist-placeholder {
			max-width: 200px;
		}
		.newsletter-form {
			flex-direction: column;
		}
	}
</style>
