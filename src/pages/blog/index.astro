---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Artículos — ${SITE_TITLE}`} description="Todos los artículos de FUENTE: cultura, arte y música cristiana." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Artículos</h1>
				<p class="page-subtitle">Cultura, arte y música cristiana. Todo lo que publicamos, en un solo lugar.</p>
			</div>
			<div class="articles-grid">
				{
					posts.map((post) => (
						<a href={`/blog/${post.id}/`} class="article-card">
							{post.data.heroImage && (
								<Image width={400} height={300} src={post.data.heroImage} alt="" />
							)}
							<div class="article-info">
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<h2>{post.data.title}</h2>
								<p class="description">{post.data.description}</p>
							</div>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: 3em;
	}
	h1 {
		font-size: 2.5em;
		margin-bottom: 0.3em;
	}
	.page-subtitle {
		color: rgb(var(--gray));
		font-size: 1em;
		margin: 0;
	}
	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5em;
	}
	.article-card {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease;
		min-width: 0;
	}
	.article-card:hover {
		transform: translateY(-4px);
	}
	.article-card :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 10px;
		margin-bottom: 1em;
	}
	.article-info h2 {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.15em;
		margin: 0 0 0.4em;
		line-height: 1.35;
		letter-spacing: -0.005em;
	}
	.article-card:hover h2 {
		color: rgb(var(--black));
	}
	.description {
		font-size: 0.85em;
		color: rgb(var(--black));
		margin: 0 0 0.6em;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		font-family: var(--font-script);
		font-weight: 400;
		font-size: 1.05em;
		color: var(--color-ink-blue);
		line-height: 1.4;
		display: block;
		margin-bottom: 0.4em;
		overflow: visible;
	}
	.date :global(time) {
		display: inline-block;
		line-height: inherit;
	}
	@media (max-width: 1024px) {
		.articles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 768px) {
		h1 {
			font-size: 2em;
		}
		.articles-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
	}
</style>
