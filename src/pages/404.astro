---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Página no encontrada — ${SITE_TITLE}`} description="Esta página se perdió. Vuelve al camino." />
	</head>
	<body>
		<Header />
		<main>
			<section class="lost-content">
				<span class="lost-eyebrow">404</span>
				<h1>Esta página se perdió.</h1>
				<p class="lost-quote">
					"Si tuvieras cien ovejas y se te perdiera una, ¿no dejarías las noventa y nueve para ir tras la que se extravió?"
				</p>
				<cite>Lucas 15:4</cite>
				<p class="lost-text">
					No encontramos lo que buscabas, pero hay mucho por leer. Empecemos de nuevo.
				</p>
				<div class="lost-actions">
					<a href="/" class="action-primary">Volver al inicio</a>
					<a href="/blog/" class="action-secondary">Ver los artículos</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 4em 1em;
		text-align: center;
	}
	.lost-eyebrow {
		font-family: var(--font-body);
		font-size: 0.9em;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(var(--gray));
		display: block;
		margin-bottom: 1.5em;
	}
	h1 {
		font-family: var(--font-display);
		font-size: clamp(1.8em, 4vw, 2.6em);
		margin: 0 0 1.5em;
		line-height: 1.2;
	}
	.lost-quote {
		font-family: var(--font-display);
		font-size: 1.15em;
		line-height: 1.6;
		color: rgb(var(--black));
		font-style: italic;
		max-width: 540px;
		margin: 0 auto 0.5em;
	}
	cite {
		font-family: var(--font-body);
		font-style: normal;
		font-size: 0.9em;
		color: var(--color-ink-blue);
		letter-spacing: 0.02em;
		display: block;
		margin-bottom: 2.5em;
	}
	.lost-text {
		font-size: 1em;
		line-height: 1.6;
		color: rgb(var(--gray-dark));
		margin: 0 0 2.5em;
	}
	.lost-actions {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}
	.action-primary,
	.action-secondary {
		display: inline-block;
		padding: 0.85em 2em;
		border-radius: 100px;
		text-decoration: none;
		font-size: 0.9em;
		font-weight: 600;
		transition: opacity 0.2s ease, background 0.2s ease;
		white-space: nowrap;
	}
	.action-primary {
		background: rgb(var(--black));
		color: white;
	}
	.action-primary:hover {
		opacity: 0.85;
	}
	.action-secondary {
		background: transparent;
		color: rgb(var(--black));
		border: 1px solid rgb(var(--gray-light));
	}
	.action-secondary:hover {
		background: var(--color-cream);
	}
</style>
