---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const SUPABASE_URL = 'https://lbwnqcmfqrmvuyhvzjye.supabase.co';
const SUPABASE_ANON_KEY =
	'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxid25xY21mcXJtdnV5aHZ6anllIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU3Nzc2NDIsImV4cCI6MjEwMTM1MzY0Mn0.iBiRn_RoPFyrguOm8mZUCqMw_UpzmXq-oXV6WHdCNEE';
const CURRENT_QUESTION = '¿Qué libro te ha marcado?';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`El mapa — ${SITE_TITLE}`}
			description="Deja tu respuesta a la pregunta de la semana y mira dónde cae en el mapa de la comunidad."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="map-intro">
				<span class="eyebrow">FUENTE · pregunta semanal</span>
				<h1>{CURRENT_QUESTION}</h1>
				<p class="lead">
					Cada respuesta se agrupa con las que apuntan a lo mismo. Mientras más personas coinciden, más grande y más
					intenso el círculo. Aprieta uno para ver el detalle.
				</p>
			</section>

			<section class="map-card">
				<div class="stage">
					<div class="canvas-wrap">
						<canvas
							id="map"
							aria-label="Mapa de respuestas de la comunidad, agrupadas por libro"></canvas>
						<p id="map-status" class="map-status" hidden></p>
					</div>

					<aside class="panel">
						<form id="form">
							<div class="field">
								<span>Tu nombre o Instagram</span>
								<input id="name-input" type="text" maxlength="30" placeholder="Ej: Cami" required />
							</div>

							<div class="field">
								<span>Tu respuesta</span>
								<input
									id="title-input"
									type="text"
									maxlength="60"
									placeholder="Ej: Mero cristianismo · C. S. Lewis"
									required
								/>
							</div>

							<button type="submit" class="submit-btn" id="submit-btn">Agregar al mapa</button>
							<p class="form-note" id="form-note">Tu respuesta aparece en el mapa apenas la mandas.</p>
						</form>
					</aside>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: calc(900px + 5em);
		margin: 0 auto;
		padding: 3em 2.5em 5em;
	}

	.map-intro {
		max-width: 640px;
		margin: 0 auto 2em;
		text-align: center;
	}

	.eyebrow {
		display: block;
		font-family: var(--font-body);
		font-size: 0.78em;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: rgb(var(--gray));
		margin-bottom: 0.6em;
	}

	.map-intro h1 {
		font-size: 2.1em;
		margin-bottom: 0.4em;
	}

	.lead {
		color: rgb(var(--gray-dark));
		line-height: 1.6;
		margin: 0;
	}

	.map-card {
		border: 1px solid rgba(var(--gray), 0.15);
		border-radius: 20px;
		overflow: hidden;
		background: var(--color-paper);
	}

	.stage {
		display: flex;
		height: 540px;
	}

	.canvas-wrap {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		background: var(--color-cream);
	}

	#map {
		display: block;
		width: 100%;
		height: 100%;
	}

	.map-status {
		position: absolute;
		inset: 0;
		display: none;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 2em;
		margin: 0;
		font-size: 0.95em;
		color: rgb(var(--gray));
	}
	.map-status:not([hidden]) {
		display: flex;
	}

	.panel {
		flex: 0 0 300px;
		border-left: 1px solid rgba(var(--gray), 0.15);
		background: var(--color-paper);
		padding: 1.6em 1.5em;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
	}

	form {
		display: flex;
		flex-direction: column;
		gap: 1em;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}

	.field span {
		font-family: var(--font-body);
		font-size: 0.8em;
		font-weight: 600;
		color: rgb(var(--black));
	}

	.field input {
		font-family: var(--font-body);
		font-size: 0.95em;
		padding: 0.7em 0.8em;
		border-radius: 8px;
		border: 1px solid rgba(var(--gray), 0.3);
		background: var(--color-paper);
		color: rgb(var(--black));
		outline: none;
		transition: border-color 0.2s ease;
	}
	.field input:focus {
		border-color: var(--color-ink-blue);
	}

	.submit-btn {
		font-family: var(--font-body);
		font-size: 0.95em;
		font-weight: 600;
		padding: 0.75em 1em;
		border-radius: 100px;
		border: none;
		background: rgb(var(--black));
		color: white;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}
	.submit-btn:hover {
		opacity: 0.85;
	}
	.submit-btn:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.form-note {
		font-size: 0.8em;
		line-height: 1.5;
		color: rgb(var(--gray));
		margin: 0;
	}

	:global(.detail-card) {
		position: absolute;
		width: 220px;
		background: rgb(var(--black));
		color: var(--color-paper);
		padding: 14px 16px;
		border-radius: 12px;
		z-index: 5;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
	}
	:global(.detail-close) {
		position: absolute;
		top: 8px;
		right: 10px;
		background: none;
		border: none;
		color: var(--color-paper);
		opacity: 0.6;
		font-size: 17px;
		line-height: 1;
		cursor: pointer;
		padding: 2px;
	}
	:global(.detail-close:hover) {
		opacity: 1;
	}
	:global(.detail-title) {
		font-family: var(--font-display);
		font-size: 16px;
		font-weight: 600;
		line-height: 1.3;
		padding-right: 18px;
		margin-bottom: 4px;
		text-wrap: balance;
	}
	:global(.detail-meta) {
		font-family: var(--font-body);
		font-size: 12px;
		opacity: 0.75;
		margin-bottom: 10px;
	}
	:global(.detail-list) {
		display: flex;
		flex-direction: column;
		gap: 7px;
		max-height: 180px;
		overflow-y: auto;
	}
	:global(.detail-person) {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-body);
		font-size: 13px;
	}
	:global(.detail-avatar) {
		flex: 0 0 auto;
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.18);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 8.5px;
		font-weight: 700;
	}

	@media (max-width: 760px) {
		main {
			padding: 2em 1.25em 4em;
		}
		.stage {
			flex-direction: column;
			height: auto;
		}
		.canvas-wrap {
			height: 380px;
		}
		.panel {
			flex: none;
			border-left: none;
			border-top: 1px solid rgba(var(--gray), 0.15);
		}
	}
</style>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, CURRENT_QUESTION }}>
	(function () {
		'use strict';

		var RAMP = { low: '#a9b0d9', high: '#13247c' };

		var canvas = document.getElementById('map');
		var ctx = canvas.getContext('2d');
		var wrap = canvas.parentElement;
		var statusEl = document.getElementById('map-status');
		var form = document.getElementById('form');
		var nameInput = document.getElementById('name-input');
		var titleInput = document.getElementById('title-input');
		var submitBtn = document.getElementById('submit-btn');
		var formNote = document.getElementById('form-note');

		var detailCard = document.createElement('div');
		detailCard.className = 'detail-card';
		detailCard.hidden = true;
		detailCard.innerHTML =
			'<button type="button" class="detail-close" aria-label="Cerrar">×</button>' +
			'<div class="detail-title"></div><div class="detail-meta"></div><div class="detail-list"></div>';
		wrap.appendChild(detailCard);
		var detailClose = detailCard.querySelector('.detail-close');
		var detailTitle = detailCard.querySelector('.detail-title');
		var detailMeta = detailCard.querySelector('.detail-meta');
		var detailList = detailCard.querySelector('.detail-list');

		var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		var bubbles = {};
		var order = [];
		var maxCount = 1;
		var dpr = Math.max(1, window.devicePixelRatio || 1);
		var W = 0,
			H = 0;
		var hovered = null;
		var selected = null;
		var rafId = null;
		var settleFrames = 0;
		var cam = { x: 0, y: 0, scale: 1 };
		var camTarget = { x: 0, y: 0, scale: 1 };
		var camInitialized = false;

		function normalize(str) {
			return str.trim().toLowerCase().replace(/\s+/g, ' ');
		}

		function getInitials(name) {
			var clean = name.replace(/^@/, '').trim();
			var parts = clean.split(/\s+/).filter(Boolean);
			if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
			return clean.slice(0, 2).toUpperCase();
		}

		function mixHex(a, b, t) {
			t = Math.max(0, Math.min(1, t));
			var ar = parseInt(a.slice(1, 3), 16),
				ag = parseInt(a.slice(3, 5), 16),
				ab = parseInt(a.slice(5, 7), 16);
			var br = parseInt(b.slice(1, 3), 16),
				bg = parseInt(b.slice(3, 5), 16),
				bb = parseInt(b.slice(5, 7), 16);
			var r = Math.round(ar + (br - ar) * t);
			var g = Math.round(ag + (bg - ag) * t);
			var bl = Math.round(ab + (bb - ab) * t);
			return (
				'#' +
				[r, g, bl]
					.map(function (v) {
						return v.toString(16).padStart(2, '0');
					})
					.join('')
			);
		}

		function relLuminance(hex) {
			var r = parseInt(hex.slice(1, 3), 16) / 255;
			var g = parseInt(hex.slice(3, 5), 16) / 255;
			var b = parseInt(hex.slice(5, 7), 16) / 255;
			function lin(c) {
				return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
			}
			return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
		}

		function textOn(hex) {
			return relLuminance(hex) > 0.42 ? '#1c1934' : '#f6f1e3';
		}

		function apiHeaders(extra) {
			var h = { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY };
			if (extra)
				for (var k in extra) h[k] = extra[k];
			return h;
		}

		function fetchApproved() {
			var url =
				SUPABASE_URL + '/rest/v1/respuestas?select=nombre,respuesta,created_at&aprobado=eq.true&order=created_at.asc';
			return fetch(url, { headers: apiHeaders() }).then(function (res) {
				if (!res.ok) throw new Error('fetch failed: ' + res.status);
				return res.json();
			});
		}

		function submitEntry(name, title) {
			var url = SUPABASE_URL + '/rest/v1/respuestas';
			return fetch(url, {
				method: 'POST',
				headers: apiHeaders({ 'Content-Type': 'application/json', Prefer: 'return=minimal' }),
				body: JSON.stringify({ nombre: name, respuesta: title, pregunta_semana: CURRENT_QUESTION })
			}).then(function (res) {
				if (!res.ok) throw new Error('insert failed: ' + res.status);
			});
		}

		function targetRadius(count) {
			var r0 = 56 / Math.sqrt(Math.max(1, maxCount));
			return Math.max(24, r0 * Math.sqrt(count));
		}

		function recomputeMax() {
			maxCount = 1;
			order.forEach(function (key) {
				maxCount = Math.max(maxCount, bubbles[key].members.length);
			});
		}

		function addEntry(name, title) {
			var key = normalize(title);
			var bubble = bubbles[key];
			if (!bubble) {
				bubble = { key: key, title: title.trim(), members: [], x: W / 2, y: H / 2, vx: 0, vy: 0, r: 0 };
				bubbles[key] = bubble;
				order.push(key);
			}
			bubble.members.push({ name: name.trim() });
			return bubble;
		}

		function buildFromRows(rows) {
			bubbles = {};
			order = [];
			rows.forEach(function (row) {
				addEntry(row.nombre, row.respuesta);
			});
			recomputeMax();
			var cx = W / 2,
				cy = H / 2;
			order.forEach(function (key) {
				var b = bubbles[key];
				b.x = cx + (Math.random() - 0.5) * 80;
				b.y = cy + (Math.random() - 0.5) * 80;
				b.vx = 0;
				b.vy = 0;
				b.r = targetRadius(b.members.length);
			});
			wake();
		}

		function resize() {
			var rect = wrap.getBoundingClientRect();
			W = rect.width;
			H = rect.height;
			dpr = Math.max(1, window.devicePixelRatio || 1);
			canvas.width = Math.round(W * dpr);
			canvas.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			if (!camInitialized) {
				cam.x = camTarget.x = W / 2;
				cam.y = camTarget.y = H / 2;
				camInitialized = true;
			}
			wake();
		}

		function zoomScaleFor(bubble) {
			var desired = Math.min(W, H) * 0.26;
			var s = desired / Math.max(18, bubble.r);
			return Math.max(1.3, Math.min(3.2, s));
		}

		function updateCamTarget() {
			if (selected && bubbles[selected]) {
				var b = bubbles[selected];
				camTarget.x = b.x;
				camTarget.y = b.y;
				camTarget.scale = zoomScaleFor(b);
			} else {
				camTarget.x = W / 2;
				camTarget.y = H / 2;
				camTarget.scale = 1;
			}
		}

		function screenToWorld(pt) {
			return { x: (pt.x - W / 2) / cam.scale + cam.x, y: (pt.y - H / 2) / cam.scale + cam.y };
		}

		function step() {
			var moving = false;
			updateCamTarget();
			cam.x += (camTarget.x - cam.x) * 0.14;
			cam.y += (camTarget.y - cam.y) * 0.14;
			cam.scale += (camTarget.scale - cam.scale) * 0.14;
			if (
				Math.abs(camTarget.x - cam.x) > 0.4 ||
				Math.abs(camTarget.y - cam.y) > 0.4 ||
				Math.abs(camTarget.scale - cam.scale) > 0.004
			) {
				moving = true;
			}

			order.forEach(function (key) {
				var b = bubbles[key];
				var target = targetRadius(b.members.length);
				b.r += (target - b.r) * 0.14;
				var cx = W / 2,
					cy = H / 2;
				b.vx += (cx - b.x) * 0.0012;
				b.vy += (cy - b.y) * 0.0012;
			});

			for (var i = 0; i < order.length; i++) {
				for (var j = i + 1; j < order.length; j++) {
					var a = bubbles[order[i]],
						b2 = bubbles[order[j]];
					var dx = b2.x - a.x,
						dy = b2.y - a.y;
					var dist = Math.sqrt(dx * dx + dy * dy) || 1;
					var minDist = a.r + b2.r + 14;
					if (dist < minDist) {
						var push = ((minDist - dist) / dist) * 0.05;
						a.vx -= dx * push;
						a.vy -= dy * push;
						b2.vx += dx * push;
						b2.vy += dy * push;
					}
				}
			}

			order.forEach(function (key) {
				var b = bubbles[key];
				b.vx *= 0.84;
				b.vy *= 0.84;
				b.x += b.vx;
				b.y += b.vy;
				var pad = b.r + 10;
				b.x = Math.max(pad, Math.min(W - pad, b.x));
				b.y = Math.max(pad, Math.min(H - pad, b.y));
				if (Math.abs(b.vx) > 0.05 || Math.abs(b.vy) > 0.05 || Math.abs(targetRadius(b.members.length) - b.r) > 0.3)
					moving = true;
			});

			draw();
			return moving;
		}

		function wake() {
			settleFrames = 0;
			if (rafId) return;
			loop();
		}

		function loop() {
			var moving = step();
			settleFrames = moving ? 0 : settleFrames + 1;
			if (settleFrames < 50 && settleFrames < 900) {
				rafId = requestAnimationFrame(loop);
			} else {
				rafId = null;
			}
		}

		function wrapTitle(text, maxWidth) {
			var words = text.split(' ');
			var lines = [];
			var current = '';
			for (var i = 0; i < words.length; i++) {
				var test = current ? current + ' ' + words[i] : words[i];
				if (ctx.measureText(test).width > maxWidth && current) {
					lines.push(current);
					current = words[i];
					if (lines.length === 2) break;
				} else {
					current = test;
				}
			}
			if (lines.length < 2 && current) lines.push(current);
			if (lines.length === 2 && ctx.measureText(lines[1]).width > maxWidth) {
				while (ctx.measureText(lines[1] + '…').width > maxWidth && lines[1].length > 1) {
					lines[1] = lines[1].slice(0, -1);
				}
				lines[1] += '…';
			}
			return lines;
		}

		function draw() {
			var bg = getComputedStyle(wrap).backgroundColor;
			var ink = '#1c1934';

			ctx.clearRect(0, 0, W, H);
			ctx.fillStyle = bg;
			ctx.fillRect(0, 0, W, H);

			ctx.save();
			ctx.translate(W / 2, H / 2);
			ctx.scale(cam.scale, cam.scale);
			ctx.translate(-cam.x, -cam.y);

			order.forEach(function (key) {
				var b = bubbles[key];
				if (b.r < 1) return;
				var count = b.members.length;
				var t = Math.sqrt(count) / Math.sqrt(Math.max(1, maxCount));
				var fill = mixHex(RAMP.low, RAMP.high, t);
				var isHover = hovered === b;

				if (isHover) {
					ctx.save();
					ctx.shadowColor = fill;
					ctx.shadowBlur = 18;
				}

				ctx.beginPath();
				ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
				ctx.fillStyle = fill;
				ctx.fill();

				if (isHover) ctx.restore();

				ctx.lineWidth = 1.5;
				ctx.strokeStyle = bg;
				ctx.beginPath();
				ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
				ctx.stroke();

				if (selected === b.key) {
					ctx.lineWidth = 2;
					ctx.strokeStyle = ink;
					ctx.beginPath();
					ctx.arc(b.x, b.y, b.r + 5, 0, Math.PI * 2);
					ctx.stroke();
				}

				var label = textOn(fill);
				var fontSize = Math.max(10, Math.min(13, b.r * 0.32));
				ctx.font = '600 ' + fontSize + 'px DM Sans, sans-serif';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';
				var lines = wrapTitle(b.title, b.r * 1.6);
				ctx.fillStyle = label;
				var lh = fontSize * 1.2;
				var startY = b.y - ((lines.length - 1) * lh) / 2;
				lines.forEach(function (line, i) {
					ctx.fillText(line, b.x, startY + i * lh);
				});

				var shown = Math.min(5, count);
				var extra = count - shown;
				var av = 18,
					overlap = 7;
				var totalW = shown * av - (shown - 1) * overlap + (extra > 0 ? av - overlap : 0);
				var startX = b.x - totalW / 2 + av / 2;
				var ay = b.y + b.r + 16;

				for (var i = 0; i < shown; i++) {
					var ax = startX + i * (av - overlap);
					ctx.beginPath();
					ctx.arc(ax, ay, av / 2, 0, Math.PI * 2);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
					ctx.lineWidth = 1;
					ctx.strokeStyle = 'rgba(0,0,0,0.15)';
					ctx.stroke();
					ctx.font = '700 8.5px DM Sans, sans-serif';
					ctx.fillStyle = ink;
					ctx.fillText(getInitials(b.members[i].name), ax, ay + 0.5);
				}
				if (extra > 0) {
					var ex = startX + shown * (av - overlap);
					ctx.beginPath();
					ctx.arc(ex, ay, av / 2, 0, Math.PI * 2);
					ctx.fillStyle = '#ffffff';
					ctx.fill();
					ctx.lineWidth = 1;
					ctx.strokeStyle = 'rgba(0,0,0,0.15)';
					ctx.stroke();
					ctx.font = '700 8px DM Sans, sans-serif';
					ctx.fillStyle = 'rgba(28,25,52,0.55)';
					ctx.fillText('+' + extra, ex, ay + 0.5);
				}
			});

			ctx.restore();

			if (selected && bubbles[selected]) positionDetail(bubbles[selected]);
		}

		function renderDetail(bubble) {
			detailTitle.textContent = bubble.title;
			var n = bubble.members.length;
			detailMeta.textContent = n + (n === 1 ? ' persona respondió esto.' : ' personas respondieron esto.');
			detailList.innerHTML = '';
			bubble.members.forEach(function (m) {
				var row = document.createElement('div');
				row.className = 'detail-person';
				var av = document.createElement('span');
				av.className = 'detail-avatar';
				av.textContent = getInitials(m.name);
				var name = document.createElement('span');
				name.textContent = m.name;
				row.appendChild(av);
				row.appendChild(name);
				detailList.appendChild(row);
			});
		}

		function positionDetail(bubble) {
			detailCard.style.left = '0px';
			detailCard.style.top = '0px';
			var cw = detailCard.offsetWidth;
			var ch = detailCard.offsetHeight;
			var sx = (bubble.x - cam.x) * cam.scale + W / 2;
			var sy = (bubble.y - cam.y) * cam.scale + H / 2;
			var sr = bubble.r * cam.scale;
			var left = sx + sr + 14;
			if (left + cw > W - 8) left = sx - sr - 14 - cw;
			left = Math.max(8, Math.min(W - cw - 8, left));
			var top = sy - ch / 2;
			top = Math.max(8, Math.min(H - ch - 8, top));
			detailCard.style.left = left + 'px';
			detailCard.style.top = top + 'px';
		}

		function selectBubble(bubble) {
			if (!bubble) {
				selected = null;
				detailCard.hidden = true;
				wake();
				draw();
				return;
			}
			selected = bubble.key;
			renderDetail(bubble);
			detailCard.hidden = false;
			positionDetail(bubble);
			wake();
			draw();
		}

		function pointFromEvent(e) {
			var rect = canvas.getBoundingClientRect();
			var cx = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
			var cy = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
			return { x: cx, y: cy };
		}

		function hitTest(pt) {
			var found = null;
			order.forEach(function (key) {
				var b = bubbles[key];
				if (Math.hypot(b.x - pt.x, b.y - pt.y) <= b.r) found = b;
			});
			return found;
		}

		canvas.addEventListener('mousemove', function (e) {
			var hit = hitTest(screenToWorld(pointFromEvent(e)));
			if (hit !== hovered) {
				hovered = hit;
				canvas.style.cursor = hit ? 'pointer' : 'default';
				draw();
			}
		});

		canvas.addEventListener('mouseleave', function () {
			hovered = null;
			canvas.style.cursor = 'default';
			draw();
		});

		canvas.addEventListener('click', function (e) {
			var hit = hitTest(screenToWorld(pointFromEvent(e)));
			selectBubble(hit && hit.key === selected ? null : hit);
		});

		detailClose.addEventListener('click', function () {
			selectBubble(null);
		});

		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape') selectBubble(null);
		});

		var resizeTimer = null;
		window.addEventListener('resize', function () {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(resize, 120);
		});

		form.addEventListener('submit', function (e) {
			e.preventDefault();
			var name = nameInput.value.trim();
			var title = titleInput.value.trim();
			if (!name || !title) return;
			submitBtn.disabled = true;
			submitBtn.textContent = 'Enviando…';
			submitEntry(name, title)
				.then(function () {
					form.reset();
					statusEl.hidden = true;
					addEntry(name, title);
					recomputeMax();
					wake();
					submitBtn.textContent = '¡Gracias! Ya está en el mapa';
					setTimeout(function () {
						submitBtn.textContent = 'Agregar al mapa';
						submitBtn.disabled = false;
					}, 2200);
				})
				.catch(function () {
					submitBtn.textContent = 'Agregar al mapa';
					submitBtn.disabled = false;
					formNote.textContent = 'No se pudo enviar. Intenta de nuevo en un momento.';
				});
		});

		resize();
		fetchApproved()
			.then(function (rows) {
				if (!rows.length) {
					statusEl.hidden = false;
					statusEl.textContent = 'Todavía no hay respuestas publicadas. ¡Sé la primera en dejar la tuya!';
				}
				buildFromRows(rows);
			})
			.catch(function () {
				statusEl.hidden = false;
				statusEl.textContent = 'No pudimos cargar el mapa. Intenta de nuevo más tarde.';
			});
	})();
</script>
